PORT=8888
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENDER_EMAIL=
REPLYTO_EMAIL=
# Preferred in every hosted environment: one url carrying host, port,
# credentials and database. A rediss:// scheme enables TLS by itself, which the
# discrete fields below cannot express. Takes precedence over all of them.
REDIS_URL=

# Local / fallback only.
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=
REDIS_USERNAME=
REDIS_DB=
RESEND_API_KEY=
DATABASE_URL=
GEMINI_API_KEY=

# RevenueCat V2 secret key (sk_...). Server only — never expose this to the
# client. Scoped to customer_information read & write; nothing else is needed.
REVENUE_CAT_SECRET=

# From the dashboard URL: app.revenuecat.com/projects/<this>/... The v2 API
# paths are all scoped by project, so entitlement pulls fail without it.
REVENUE_CAT_PROJECT_ID=

# Guards POST /v1/maintenance/reminders/sweep, which lets a platform cron job
# drive the daily reminder sweep on a host that sleeps when idle. Unset, the
# endpoint stays shut rather than open.
CRON_SECRET=
