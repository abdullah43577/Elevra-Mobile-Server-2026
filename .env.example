PORT=8888
# 'development' locally only: selects the passwordless localhost Redis (no
# REDIS_* fields needed) and includes error details in 500 responses. Leave it
# unset on a host.
NODE_ENV=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENDER_EMAIL=
REPLYTO_EMAIL=
# Preferred in every hosted environment: one url carrying host, port,
# credentials and database. A rediss:// scheme enables TLS by itself, which the
# discrete fields below cannot express. Takes precedence over all of them.
REDIS_URL=

# Local / fallback only.
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=
REDIS_USERNAME=
REDIS_DB=
RESEND_API_KEY=
DATABASE_URL=

# AI providers, tried in order by src/lib/ai.ts: Groq first, OpenRouter as the
# fallback. Either one alone works; with neither set every AI call answers 503
# AI_UNAVAILABLE. Groq is also the only one that can transcribe audio.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# RevenueCat V2 secret key (sk_...). Server only — never expose this to the
# client. Scoped to customer_information read & write; nothing else is needed.
REVENUE_CAT_SECRET=

# From the dashboard URL: app.revenuecat.com/projects/<this>/... The v2 API
# paths are all scoped by project, so entitlement pulls fail without it.
REVENUE_CAT_PROJECT_ID=

# Guards POST /v1/maintenance/reminders/sweep, which lets a platform cron job
# drive the daily reminder sweep on a host that sleeps when idle. Unset, the
# endpoint stays shut rather than open.
CRON_SECRET=

# --- Social sign-in ---------------------------------------------------------
# These are OAuth *client ids*, not secrets — the client ships them too. They
# matter because they are the ID token's expected audience: without the right
# value a token that verifies perfectly against Google's keys is still rejected,
# and with a wrong one someone else's app could sign in as your users.
#
# From Google Cloud Console -> APIs & Services -> Credentials. The web client id
# is the one the mobile SDK asks for an idToken against, so it is required on
# every platform. Comma-separate to accept more than one.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Native iOS Apple sign-in audiences the app's bundle id; the Android/web flow
# audiences the Services ID from the Apple developer portal. Set both if the
# Apple button is shown on both platforms.
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
