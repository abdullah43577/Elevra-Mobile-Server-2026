enum InterviewCategory {
  BACKGROUND
  BEHAVIOURAL
  SITUATIONAL
  MOTIVATION
  STRENGTHS
  ROLE_SPECIFIC
  CLOSING
}

enum AnswerStatus {
  DRAFT
  NEEDS_WORK
  READY
}

// userId is null for the seeded catalogue, set for a question the user wrote.
model InterviewQuestion {
  id           String            @id @default(cuid())
  text         String
  category     InterviewCategory
  guidance     String?

  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  seedKey      String?           @unique

  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)

  answers      InterviewAnswer[]
  applications ApplicationQuestion[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([category])
}

model InterviewAnswer {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId     String
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text           String?
  audioUrl       String?
  audioDuration  Int?

  // Describes the take in audioUrl only: replacing or deleting the take clears it.
  transcript     String?
  feedback       Json?

  status         AnswerStatus      @default(DRAFT)

  practiceCount  Int               @default(0)
  lastPracticedAt DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([status])
}

model ApplicationQuestion {
  id            String            @id @default(cuid())
  applicationId String
  questionId    String
  application   JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt     DateTime          @default(now())

  @@unique([applicationId, questionId])
  @@index([questionId])
}
