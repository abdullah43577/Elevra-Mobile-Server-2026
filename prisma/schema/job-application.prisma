enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

model JobApplication {
  id              String            @id @default(cuid())
  company         String
  role            String
  location        String?
  workArrangement WorkArrangement?
  jobUrl          String?
  source          String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  status          ApplicationStatus @default(SAVED)
  appliedAt       DateTime?
  notes           String?

  jobDescription  String?

  // Hash of the jobDescription the keywords came from; a mismatch means they are stale.
  jobKeywords     Json?
  jobKeywordsHash String?

  isArchived      Boolean           @default(false)

  lastReminderAt  DateTime?

  // Reminder rules key off this, never updatedAt: @updatedAt also bumps on the sweep's own writes.
  statusChangedAt DateTime          @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  coverLetterId String?
  coverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  linkedQuestions  ApplicationQuestion[]
  linkedNotes      ApplicationNote[]
  linkedRecordings ApplicationRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([resumeId])
  @@index([coverLetterId])
  @@index([isArchived])
}

model ApplicationNote {
  id            String         @id @default(cuid())
  applicationId String
  noteId        String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  note          Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([applicationId, noteId])
  @@index([noteId])
}

model ApplicationRecording {
  id            String         @id @default(cuid())
  applicationId String
  recordingId   String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recording     VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([applicationId, recordingId])
  @@index([recordingId])
}
