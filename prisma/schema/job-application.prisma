enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

model JobApplication {
  id              String            @id @default(cuid())
  company         String
  role            String
  location        String?
  workArrangement WorkArrangement?
  jobUrl          String?
  source          String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  status          ApplicationStatus @default(SAVED)
  appliedAt       DateTime?
  notes           String?

  // The posting itself, pasted in. Kept beside the application because the ad
  // is usually deleted or rewritten by the time an interview comes round, and
  // it is the one thing you want in front of you while preparing.
  jobDescription  String?

  isArchived      Boolean           @default(false)

  // Last time a follow-up reminder fired for this application. Guards the
  // daily sweep against nagging the same row every single day.
  lastReminderAt  DateTime?

  // When the status last actually changed. Reminder rules must key off this,
  // never updatedAt — @updatedAt bumps on every write, including the sweep's
  // own markReminded, so updatedAt silently resets the idle clock.
  statusChangedAt DateTime          @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The resume version actually sent. SetNull so deleting a resume does not
  // erase the application history it was attached to.
  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  // The cover letter actually sent. SetNull for the same reason as resumeId:
  // deleting a letter must not erase the application it was attached to.
  coverLetterId String?
  coverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  linkedQuestions  ApplicationQuestion[]
  linkedNotes      ApplicationNote[]
  linkedRecordings ApplicationRecording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([resumeId])
  @@index([coverLetterId])
  @@index([isArchived])
}

model ApplicationNote {
  id            String         @id @default(cuid())
  applicationId String
  noteId        String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  note          Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([applicationId, noteId])
  @@index([noteId])
}

model ApplicationRecording {
  id            String         @id @default(cuid())
  applicationId String
  recordingId   String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recording     VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([applicationId, recordingId])
  @@index([recordingId])
}
