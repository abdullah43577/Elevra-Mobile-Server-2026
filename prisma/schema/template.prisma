// ────────────────────────────────
// Enums
// ────────────────────────────────

enum LayoutKey {
  // ATS-first set. All single-column; they differ in header and section-title
  // treatment only.
  ATS_CLEAN
  ATS_ACCENT
  MODERN_BANNER
  COMPACT_DENSE
  TIMELINE_ACCENT
  TECH_FOCUSED

  // Original four. Retired from the catalogue (isActive false) but kept in the
  // enum because existing Resume rows still reference their templates.
  PROFESSIONAL_CLASSIC
  PROFESSIONAL_SLEEK
  CREATIVE_SPLIT
  MINIMAL_COMPACT
  EXECUTIVE_FORMAL
}

enum FontFamily {
  INTER
  ROBOTO
  MERRIWEATHER
  LORA
  PLAYFAIR
}

enum Spacing {
  COMPACT
  NORMAL
  SPACIOUS
}

// ────────────────────────────────
// Theme
// ────────────────────────────────

model ResumeTheme {
  id               String     @id @default(cuid())
  name             String
  description      String?

  primaryColor     String
  secondaryColor   String?
  textColor        String
  fontFamily       FontFamily
  spacing          Spacing

  accentColor      String?
  sidebarColor     String?
  sidebarTextColor String?
  showBorders      Boolean?
  showDividers     Boolean?
  useIcons         Boolean?
  goldAccent       String?
  showAwards       Boolean?

  templates        Template[]
  resumes          Resume[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ────────────────────────────────
// Template
// ────────────────────────────────

model Template {
  id          String     @id @default(cuid())
  name        String
  description String?
  category    String

  layoutKey   LayoutKey
  themeId     String
  theme       ResumeTheme      @relation(fields: [themeId], references: [id])

  // Sample resume content used to render the template's preview/thumbnail.
  defaultData Json

  isPremium   Boolean    @default(false)
  isActive    Boolean    @default(true)

  resumes     Resume[]
  coverLetters CoverLetter[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([layoutKey])
  @@index([isPremium])
}

