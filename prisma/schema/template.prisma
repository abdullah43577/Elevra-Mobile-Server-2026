// ────────────────────────────────
// Enums
// ────────────────────────────────

enum LayoutKey {
  PROFESSIONAL_CLASSIC
  PROFESSIONAL_SLEEK
  CREATIVE_SPLIT
  MINIMAL_COMPACT
  EXECUTIVE_FORMAL
}

enum FontFamily {
  INTER
  ROBOTO
  MERRIWEATHER
  LORA
  PLAYFAIR
}

enum Spacing {
  COMPACT
  NORMAL
  SPACIOUS
}

// ────────────────────────────────
// Theme
// ────────────────────────────────

model ResumeTheme {
  id               String     @id @default(cuid())
  name             String
  description      String?

  primaryColor     String
  secondaryColor   String?
  textColor        String
  fontFamily       FontFamily
  spacing          Spacing

  accentColor      String?
  sidebarColor     String?
  sidebarTextColor String?
  showBorders      Boolean?
  showDividers     Boolean?
  useIcons         Boolean?
  goldAccent       String?
  showAwards       Boolean?

  templates        Template[]
  resumes          Resume[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ────────────────────────────────
// Template
// ────────────────────────────────

model Template {
  id          String     @id @default(cuid())
  name        String
  description String?
  category    String

  layoutKey   LayoutKey
  themeId     String
  theme       ResumeTheme      @relation(fields: [themeId], references: [id])

  // Sample resume content used to render the template's preview/thumbnail.
  defaultData Json

  // Static thumbnail URL (generated once via react-native-view-shot + Cloudinary)
  thumbnail   String?    // Cloudinary URL

  isPremium   Boolean    @default(false)
  isActive    Boolean    @default(true)

  resumes     Resume[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([layoutKey])
  @@index([isPremium])
}

