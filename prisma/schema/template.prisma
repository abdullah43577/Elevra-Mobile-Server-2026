enum LayoutKey {
  ATS_CLEAN
  ATS_ACCENT
  MODERN_BANNER
  COMPACT_DENSE
  TIMELINE_ACCENT
  TECH_FOCUSED

  // Retired (isActive false) but kept: existing Resume rows still reference them.
  PROFESSIONAL_CLASSIC
  PROFESSIONAL_SLEEK
  CREATIVE_SPLIT
  MINIMAL_COMPACT
  EXECUTIVE_FORMAL
}

enum FontFamily {
  INTER
  ROBOTO
  MERRIWEATHER
  LORA
  PLAYFAIR
}

enum Spacing {
  COMPACT
  NORMAL
  SPACIOUS
}

model ResumeTheme {
  id               String     @id @default(cuid())
  name             String
  description      String?

  primaryColor     String
  secondaryColor   String?
  textColor        String
  fontFamily       FontFamily
  spacing          Spacing

  accentColor      String?
  sidebarColor     String?
  sidebarTextColor String?
  showBorders      Boolean?
  showDividers     Boolean?
  useIcons         Boolean?
  goldAccent       String?

  templates        Template[]
  resumes          Resume[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Template {
  id          String     @id @default(cuid())
  name        String
  description String?
  category    String

  layoutKey   LayoutKey
  themeId     String
  theme       ResumeTheme      @relation(fields: [themeId], references: [id])

  defaultData Json

  isActive    Boolean    @default(true)

  resumes     Resume[]
  coverLetters CoverLetter[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([layoutKey])
}

