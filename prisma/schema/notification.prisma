enum NotificationType {
  SYSTEM
  APPLICATION_STATUS
  APPLICATION_REMINDER
  RESUME_EXPORT
  NOTE_SUMMARY
  VOICE_TRANSCRIPTION
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType @default(SYSTEM)

  title  String
  body   String
  isRead Boolean   @default(false)
  readAt DateTime?

  // Deep-link target for the client. Kept as loose strings rather than a
  // relation because a notification must outlive the record it points at.
  entityType String?
  entityId   String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
